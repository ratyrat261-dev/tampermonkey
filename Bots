        إذا (vShieldButton) {
            vShieldButton.textContent = `Vsh ${botConfig.vShield ? 'ON' : 'OFF'}`;
            vShieldButton.classList.toggle('نشط', botConfig.vShield);
        }
    };

    window.toggleAIMode = () => {
        botConfig.botAi = !botConfig.botAi؛
        ثابت aiModeButton = document.querySelector(".small-button:nth-child(5)");
        إذا (زر وضع ai) {
            aiModeButton.textContent = `Ai ${botConfig.botAi ? 'ON' : 'OFF'}`;
            aiModeButton.classList.toggle('نشط', botConfig.botAi);
        }
