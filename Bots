    دالة saveSettings() {
        ثابت botNameInput = document.getElementById('botName');
        ثابت botAmountInput = document.getElementById('botAmount');
        إذا لم يكن (botNameInput || !botAmountInput) ارجع؛

        ثابت botName = botNameInput.value.trim();
        دع botAmount = parseInt(botAmountInput.value)؛

        إذا (isNaN(botAmount) || botAmount < 1) botAmount = 150؛
        إذا (botAmount > 200) botAmount = 200؛

        localStorage.setItem('scarz-bot-name', botName || 'ScarzBots');
        localStorage.setItem('botAmount', botAmount);

        botConfig.botCount = botAmount؛

        Bots.forEach(bot => {
            bot.name = botName || 'ScarzBots';
        });

        إذا لم يتم تشغيل botConfig.startedBots
            document.querySelector(".scarz-botCount").textContent = `${botConfig.botCount}`;
        }
        تحديث عدد الروبوتات();
    }

    دالة initKeybinds() {
        document.addEventListener('keydown', (e) => {
            إذا (e.key.toUpperCase() === botConfig.keybinds.modeKey) {
                window.toggleAIMode();
            } وإلا إذا (e.key.toUpperCase() === botConfig.keybinds.vShieldKey) {
                window.toggleVShield();
            } وإلا إذا (e.key.toUpperCase() === botConfig.keybinds.splitKey) {
                Bots.forEach(bot => {
                    إذا (bot.isAlive وbot.connected) {
                        bot.split();
                    }
                });
            } وإلا إذا (e.key.toUpperCase() === botConfig.keybinds.feedKey) {
                Bots.forEach(bot => {
                    إذا (bot.isAlive وbot.connected) {
                        bot.eject();
                    }
                });
            }
        });
    }

    ثابت initWebSocket = () => {
        const allowedUrls = ["delt.io", "ixagar", "glitch", "socket.io", "firebase", "agartool.io"];
        ثابت مسموح به = url => allowedUrls.some(المجال => url.includes(المجال));
        إذا لم يكن (WebSocket.prototype._originalSend) {
            WebSocket.prototype._originalSend = WebSocket.prototype.send؛
            WebSocket.prototype.send = دالة (بيانات) {
                إذا لم يكن مسموحًا به (هذا الرابط) {
                    botConfig.agarServer = هذا.url؛
                }
                WebSocket.prototype._originalSend.call(هذه البيانات)؛
            };
        }
    };

    ثابت initInterval = () => {
        setInterval(() => {
            إذا (window.app?.unitManager?.activeUnit?.cursor) {
                botConfig.cords.x = window.app.unitManager.activeUnit.cursor.x؛
                botConfig.cords.y = window.app.unitManager.activeUnit.cursor.y؛
            } وإلا إذا (window.app?.mouse) {
                botConfig.cords.x = window.app.mouse.x؛
                botConfig.cords.y = window.app.mouse.y؛
            }
        }, 50);
    };

    إذا (/agar.io/.test(اسم الموقع المضيف)) {
        const checkApp = setInterval(() => {
            إذا (نافذة التطبيق) {
                clearInterval(checkApp);
                حقن النص البرمجي();
                window.startBots = startBots؛
            }
        }, 100);
    }
